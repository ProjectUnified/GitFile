# Maintainer: HSGamer <huynhqtienvtag@gmail.com>

pkgname=gitfile-git
pkgver=r1.0fb53c1
pkgrel=1
pkgdesc='One patch per file for projects that track an upstream commit (VCS)'
arch=('any')
url='https://github.com/ProjectUnified/GitFile'
license=('MIT')
depends=('git' 'python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=('git+https://github.com/ProjectUnified/GitFile.git')
sha256sums=('SKIP')

pkgver() {
  cd GitFile
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd GitFile
  python -m build --wheel --no-isolation
}

check() {
  cd GitFile
  python -m unittest discover -s tests -p 'test_*.py'
}

package() {
  cd GitFile
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
