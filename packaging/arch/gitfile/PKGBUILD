# Maintainer: HSGamer <huynhqtienvtag@gmail.com>

pkgname=gitfile
pkgver=0.1.0
pkgrel=1
pkgdesc='One patch per file for projects that track an upstream commit'
arch=('any')
url='https://github.com/ProjectUnified/GitFile'
license=('MIT')
depends=('git' 'python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e6410e65d8d02253080f5f500400a21ee072e794d90c74d9c1fe3b818800b217')

build() {
  cd "GitFile-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "GitFile-$pkgver"
  python -m unittest discover -s tests -p 'test_*.py'
}

package() {
  cd "GitFile-$pkgver"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
